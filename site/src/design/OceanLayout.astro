---
// The page frame of plugins.octipus.cc: octipus.cc's head, atmosphere,
// header and footer around a page's content.
//
// No cookies, no analytics, no external scripts: the only remote resource is
// the Manrope font from Google Fonts. The two inline scripts are the files in
// src/scripts/ (lib/inline-scripts.mjs): their hashes, computed from those
// files, are the only scripts the CSP allows, and the build fails on any
// other script in a page (astro.config.mjs).
import './tokens.css';
import './ocean.css';
import OceanAtmosphere from './OceanAtmosphere.astro';
import OceanFooter from './OceanFooter.astro';
import OceanHeader from './OceanHeader.astro';
import { INLINE_SCRIPTS } from '../lib/inline-scripts.mjs';

interface Props { title: string; description: string; path: string }
const { title, description, path } = Astro.props;
const canonical = new URL(path, 'https://plugins.octipus.cc').href;
const thumbnail = new URL('/icons/octipus.png', 'https://plugins.octipus.cc').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={thumbnail}>
    <meta property="og:image:width" content="512">
    <meta property="og:image:height" content="512">
    <meta property="og:image:alt" content="Octipus logo">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:image" content={thumbnail}>
    <meta name="twitter:image:alt" content="Octipus logo">
    <meta name="theme-color" content="#061b25">
    <meta name="referrer" content="no-referrer">
    <link rel="icon" href="/icons/octipus.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icons/mobile-180.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="ocean-example open-water">
    <a class="skip-link" href="#main">Skip to content</a>
    <OceanAtmosphere />
    <OceanHeader />
    <main id="main">
      <slot />
    </main>
    <OceanFooter />
    <script is:inline set:html={INLINE_SCRIPTS.header}></script>
  </body>
</html>
