---
import OceanLayout from '../design/OceanLayout.astro';
import '../styles/market.css';
---
<OceanLayout title="Not found — Octipus plugins" description="This page is not in the Octipus marketplace." path="/404.html">
  <section class="market-hero ocean-shell" aria-labelledby="nf-title">
    <p class="ocean-eyebrow"><span></span> Not found</p>
    <h1 id="nf-title">Nothing down here.<br><span>Yet.</span></h1>
    <p class="market-intro">This page is not in the marketplace. It may have been a plugin that was withdrawn.</p>
    <div class="ocean-actions market-actions"><a class="explore-button" href="/">All plugins <span aria-hidden="true">↑</span></a></div>
  </section>
</OceanLayout>
